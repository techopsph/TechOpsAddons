<odoo>
    <record id="view_slide_form_custom_embed" model="ir.ui.view">
        <field name="name">slide.slide.form.embed.custom</field>
        <field name="model">slide.slide</field>
        <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='lesson_details']" position="inside">
                <field name="embed_code_custom" widget="html"
                    attrs="{'invisible': [('video_source_type', '!=', 'custom')]}"/>
            </xpath>
        </field>
    </record>

</odoo>